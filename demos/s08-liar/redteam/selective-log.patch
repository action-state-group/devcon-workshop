+/// The selective-log toggle: the file `CAPSULES_REDTEAM_SELECTIVE_LOG` names
+/// (default `/var/lib/redteam/selective-log.on`). While it exists, served
+/// exchanges alternate kept, dropped, kept, ... counted from when it appeared.
+fn redteam_drop_this_one() -> bool {
+    use std::sync::atomic::{AtomicU64, Ordering};
+    static SEEN_WHILE_ON: AtomicU64 = AtomicU64::new(0);
+    let path = std::env::var("CAPSULES_REDTEAM_SELECTIVE_LOG")
+        .unwrap_or_else(|_| "/var/lib/redteam/selective-log.on".to_string());
+    if !std::path::Path::new(&path).exists() {
+        SEEN_WHILE_ON.store(0, Ordering::Relaxed);
+        return false;
+    }
+    SEEN_WHILE_ON.fetch_add(1, Ordering::Relaxed) % 2 == 1
+}
