#!/usr/bin/env -S python3 -I
"""lightning: the trading agent's REAL Lightning payment, from your own lexe wallet (mainnet).

Used only in a `devcon8 trade --pay lexe` run. It talks to your own Lexe wallet through the lexe-sidecar
that `devcon8 wallet` and `devcon8 trade --pay lexe` run on this container (no mesh-llm node), and
enforces the caps you set with `devcon8 lightning`; the agent cannot raise them. It never prints a payment's preimage or a BOLT11 invoice. The seller's
received preimage, the proof the payment settled, is kept only in the 0600 file `deal note` seals
it from (Steven: seal the preimage, not the BOLT11); the buyer's is not kept.

  lightning invoice <conversation>
      seller: ask your wallet for an invoice at your price; `mbx reply ... --invoice` sends it
  lightning pay <conversation> <msat> <content-digest>
      buyer: pay the invoice the shop's proposal carried (saved by `mbx wait`, which shows its
      `invoice_msat`), within your caps and only if it asks exactly <msat>, the amount your user
      said yes to; writes your terms leg to attach to your accept.
  lightning inspect <conversation>
      buyer: what the shop's invoice asks and where it pays (its amount, node id and expiry), to show
      your user before the payment check; pays nothing
  lightning receive <conversation> <payment-hash>
      seller: wait until your wallet reports that payment of your invoice settled; writes the two
      files `deal note --kind payment_received --ln-invoice ... --ln-transaction ...` reads (0600,
      the transaction with its preimage, which deal checks and seals)
  lightning caps
      show your caps and what this container has paid so far
"""
import contextlib, datetime, decimal, fcntl, hashlib, json, math, os, re, subprocess, sys, time, urllib.error, urllib.parse, urllib.request

HOME = os.path.expanduser("~")
ST = os.path.join(HOME, ".devcon8")
DEALS = os.path.join(HOME, "deals")
CAPS = os.path.join(ST, "lightning.json")
SPENT = os.path.join(ST, "lightning-spent.json")
# lexe-sidecar, Lexe's own local HTTP API for your wallet (docs.lexe.tech/sidecar); lib/common.sh runs it.
API = os.environ.get("DEVCON8_LEXE_API", "http://127.0.0.1:5393")
# Bitcoin mainnet as a CAIP-19 asset, counted in millisatoshi: the asset the seller's
# payment_received leg names too (capsulectl deal note --ln-invoice).
BTC = "bip122:000000000019d6689c085ae165831e93/slip44:0"
BTC_SCALE = 11
# What a payment's fee is expected to cost, from Lexe's node source (lexe-ln balance.rs, 2026-09):
# 750 ppm LSP fee plus three network hops at a mean 817 ppm, and 3 sats of base fees. lexe-sidecar's
# pay_invoice takes no fee limit (the node enforces its own, 1% + 100 sats), so this estimate is what
# a payment is checked and reserved against; the fee Lexe reports is what is recorded.
EST_FEE_PPM = 750 + 3 * 817
EST_FEE_BASE_MSAT = 3000
ID = re.compile(r"^[A-Za-z0-9_-]{1,128}$")
NODE_ID = re.compile(r"^0[23][0-9a-f]{64}$")
SAFE_TEXT = re.compile(r"ln[a-z0-9]{20,}|[0-9a-f]{64}|[^A-Za-z0-9 .,:;()'_-]")
HEX64 = re.compile(r"^[0-9a-f]{64}$")
# A mainnet BOLT11 invoice with an amount: what `mbx wait` saves from a proposal.
BOLT11 = re.compile(r"^lnbc[0-9]{1,12}[munp]?1[qpzry9x8gf2tvdw0s3jn54khce6mua7l]{100,1500}$")


def die(msg, code=1):
    print("lightning: " + msg, file=sys.stderr)
    sys.exit(code)


def load(path, default=None):
    try:
        with open(path) as f:
            return json.load(f)
    except FileNotFoundError:
        return default
    except ValueError:
        die(f"{path} is not valid JSON: nothing paid. For your caps, set them again with 'devcon8 lightning'")


def write_private(path, value):
    os.makedirs(os.path.dirname(path), mode=0o700, exist_ok=True)
    tmp = path + ".tmp"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        json.dump(value, f, indent=1)
    os.replace(tmp, path)


def without_status_text(value):
    """A wallet answer without status text a provider may fill; its preimage stays, for deal to
    check and seal."""
    return {k: v for k, v in value.items() if k != "status_msg"}


# The sidecar is on this machine: never through a proxy from the environment, which would see
# the invoice.
OPENER = urllib.request.build_opener(urllib.request.ProxyHandler({}))


class Refused(Exception):
    """The wallet API answered a call with an HTTP error (its redacted detail)."""


def msat_of(sats):
    """A sidecar amount (decimal sats, a string) as whole msat."""
    try:
        v = decimal.Decimal(str(sats)) * 1000
    except decimal.InvalidOperation:
        die("the wallet reported an amount that is not a number; nothing more was done")
    if v != v.to_integral_value() or v < 0:
        die("the wallet reported an amount that is not whole msat; nothing more was done")
    return int(v)


def sats_of(msat):
    return format(decimal.Decimal(msat) / 1000, "f")


def sidecar(method, path, body=None, query=None, timeout=30, refused_ok=False, paying=False):
    """One lexe-sidecar call. Errors are reported without the request (it may hold an invoice) and
    without anything that looks like an invoice or a preimage. With refused_ok, an HTTP error is
    raised as Refused for the caller to handle."""
    url = API + path + ("?" + urllib.parse.urlencode(query) if query else "")
    req = urllib.request.Request(url, data=None if body is None else json.dumps(body).encode(), method=method,
                                 headers={"Content-Type": "application/json"})
    try:
        with OPENER.open(req, timeout=timeout) as r:
            return json.loads(r.read() or b"null")
    except urllib.error.HTTPError as e:
        detail = e.read()[:400].decode("utf-8", "replace")
        detail = re.sub(r"ln[a-z0-9]{20,}|[0-9a-f]{64}", "<redacted>", detail, flags=re.I)
        if refused_ok:
            raise Refused(f"HTTP {e.code} {detail}")
        die(f"the wallet refused '{path}': HTTP {e.code} {detail}")
    except (urllib.error.URLError, TimeoutError) as e:
        if paying and not isinstance(getattr(e, "reason", None), ConnectionRefusedError):
            die("no answer from the wallet while paying: the payment may still be in flight. Run the same "
                "'lightning pay' again (the wallet pays one invoice at most once) or look at 'devcon8 wallet'")
        die(f"your lexe wallet does not answer ({type(e).__name__}): 'devcon8 wallet' opens it ('devcon8 trade --pay lexe' does too)")


# --- BOLT11 decoding: lexe-sidecar's analyze returns neither an invoice's payment hash nor its payee.
BECH = "qpzry9x8gf2tvdw0s3jn54khce6mua7l"
P = 2**256 - 2**32 - 977
N = 0xFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFEBAAEDCE6AF48A03BBFD25E8CD0364141
G = (0x79BE667EF9DCBBAC55A06295CE870B07029BFCDB2DCE28D959F2815B16F81798,
     0x483ADA7726A3C4655DA4FBFC0E1108A8FD17B448A68554199C47D08FFB10D4B8)


def _polymod(values):
    gen = (0x3B6A57B2, 0x26508E6D, 0x1EA119FA, 0x3D4233DD, 0x2A1462B3)
    chk = 1
    for v in values:
        top = chk >> 25
        chk = (chk & 0x1FFFFFF) << 5 ^ v
        for i in range(5):
            chk ^= gen[i] if (top >> i) & 1 else 0
    return chk


def _ec_add(a, b):
    if a is None:
        return b
    if b is None:
        return a
    if a[0] == b[0]:
        if (a[1] + b[1]) % P == 0:
            return None
        m = 3 * a[0] * a[0] * pow(2 * a[1], -1, P) % P
    else:
        m = (b[1] - a[1]) * pow(b[0] - a[0], -1, P) % P
    x = (m * m - a[0] - b[0]) % P
    return x, (m * (a[0] - x) - a[1]) % P


def _ec_mul(k, pt):
    out = None
    while k:
        if k & 1:
            out = _ec_add(out, pt)
        pt = _ec_add(pt, pt)
        k >>= 1
    return out


def _recover(digest, r, s, recid):
    """The public key (33 bytes) that made an ECDSA signature over a 32-byte digest."""
    x = r + (N if recid & 2 else 0)
    if not (0 < r < N and 0 < s < N) or x >= P:
        return None
    y = pow((x**3 + 7) % P, (P + 1) // 4, P)
    if y * y % P != (x**3 + 7) % P:
        return None
    if (y & 1) != (recid & 1):
        y = P - y
    e = int.from_bytes(digest, "big")
    q = _ec_mul(pow(r, -1, N), _ec_add(_ec_mul(s, (x, y)), _ec_mul((-e) % N, G)))
    return None if q is None else bytes([2 + (q[1] & 1)]) + q[0].to_bytes(32, "big")


def _bits_to_bytes(groups, pad=True):
    acc = 0
    for g in groups:
        acc = acc << 5 | g
    n = len(groups) * 5
    if n % 8:  # pad with zero bits, or drop the zero bits a 5-bit field ends with
        if pad:
            acc <<= 8 - n % 8
            n += 8 - n % 8
        else:
            acc >>= n % 8
            n -= n % 8
    return acc.to_bytes(n // 8, "big")


def decode_invoice(text):
    """A mainnet BOLT11 invoice's payment_hash, amount_msat (None when it asks none), payee and
    expires_at_ms, with its bech32 checksum and signature checked; None when it is not one."""
    text = text.strip().lower()
    pos = text.rfind("1")
    m = re.match(r"^lnbc([0-9]*)([munp]?)$", text[:pos]) if pos > 0 else None
    if not m or any(c not in BECH for c in text[pos + 1:]):
        return None
    hrp = text[:pos]
    data = [BECH.index(c) for c in text[pos + 1:]]
    if _polymod([ord(c) >> 5 for c in hrp] + [0] + [ord(c) & 31 for c in hrp] + data) != 1 or len(data) < 7 + 104 + 6:
        return None
    data = data[:-6]
    body, sig = data[:-104], data[-104:]
    amount = None
    if m.group(1):
        if m.group(1)[0] == "0":
            return None
        num = int(m.group(1))
        per = {"": 10**11, "m": 10**8, "u": 10**5, "n": 100}.get(m.group(2))
        if per is None:  # pico-bitcoin: tenths of a msat
            if num % 10:
                return None
            per, num = 1, num // 10
        amount = num * per
    elif m.group(2):
        return None
    ts = sum(g << (5 * (6 - i)) for i, g in enumerate(body[:7]))
    expiry, phash, node, i = 3600, None, None, 7
    while i + 3 <= len(body):
        tag, ln_ = body[i], body[i + 1] * 32 + body[i + 2]
        val = body[i + 3:i + 3 + ln_]
        if len(val) != ln_:
            return None
        if tag == 1 and ln_ == 52:
            phash = _bits_to_bytes(val, pad=False)[:32].hex()
        elif tag == 6:
            expiry = sum(g << (5 * (len(val) - 1 - j)) for j, g in enumerate(val))
        elif tag == 19 and ln_ == 53:
            node = _bits_to_bytes(val, pad=False)[:33].hex()
        i += 3 + ln_
    if i != len(body) or phash is None:
        return None
    raw = _bits_to_bytes(sig, pad=False)[:65]
    digest = hashlib.sha256(hrp.encode() + _bits_to_bytes(body)).digest()
    key = _recover(digest, int.from_bytes(raw[:32], "big"), int.from_bytes(raw[32:64], "big"), raw[64])
    if key is None or (node is not None and node != key.hex()):
        return None
    return {"payment_hash": phash, "amount_msat": amount, "payee": key.hex(), "expires_at_ms": (ts + expiry) * 1000}


def _tx(p):
    """A sidecar Payment as the transaction shape the rest of this tool (and `deal note
    --ln-transaction`) reads."""
    status = {"completed": "succeeded", "failed": "failed"}.get(p.get("status"), "pending")
    return {"id": p.get("index"), "payment_hash": p.get("hash"), "inbound": p.get("direction") == "inbound",
            "amount_msat": msat_of(p["amount"]) if p.get("amount") is not None else 0, "fee_msat": msat_of(p.get("fees", "0")),
            "status": status, "status_msg": p.get("status_msg", ""), "created_at_ms": p.get("created_at"),
            "settled_at_ms": p.get("finalized_at"), "preimage": p.get("preimage")}


def wallet(command, timeout=30, refused_ok=False):
    """One wallet operation, answered in the shapes this tool works with."""
    name = command["command"]
    if name == "fund":
        r = sidecar("POST", "/v2/node/create_invoice", {"amount": sats_of(command["amount_msat"]), "expiration_secs": 86400})
        d = decode_invoice(str(r.get("invoice", ""))) if isinstance(r, dict) else None
        if d is None or d["payment_hash"] != r.get("payment_hash"):
            die("the wallet's invoice is not a mainnet invoice for your price; nothing was sent")
        return {"bolt11": r["invoice"], **d}
    if name == "inspect_invoice":
        d = decode_invoice(command["invoice"])
        if d is None:
            die("the shop's invoice does not decode (checksum or signature); nothing paid")
        return d
    if name == "send":
        return _tx(sidecar("POST", "/v2/node/pay_invoice", {"invoice": command["invoice"]}, timeout=timeout,
                           refused_ok=refused_ok, paying=True))
    if name == "payment":
        # By payment id, which syncs with the node first (list_payments reads a local copy that can be behind).
        try:
            r = sidecar("GET", "/v2/node/payment_by_id", query={"id": "ln_" + command["hash"]}, refused_ok=True)
        except Refused as e:
            if str(e).startswith("HTTP 404"):
                return None
            die(f"the wallet refused the payment lookup: {e}")
        return _tx(r) if isinstance(r, dict) else None
    die(f"unknown wallet operation {name}", 2)


def caps():
    """The caps in millisatoshi: price_msat, per_payment_msat, total_msat. A caps file an earlier
    image wrote in whole sats (price_sats, ...) is read as sats."""
    c = load(CAPS)
    if not isinstance(c, dict):
        die("no caps set: run 'devcon8 lightning --price-sats P --per-payment-sats N --total-sats T' first")
    out = {}
    for k in ("price", "per_payment", "total"):
        v = c.get(k + "_msat", c[k + "_sats"] * 1000 if isinstance(c.get(k + "_sats"), int) else None)
        if not isinstance(v, int) or isinstance(v, bool) or v < 1:
            die(f"{CAPS}: {k} must be a whole number of msat (or sats), at least 1 (set it with 'devcon8 lightning')")
        out[k + "_msat"] = v
    return out


def est_fee(msat):
    """The fee a payment of this size is expected to cost, in msat (see EST_FEE_PPM)."""
    return math.ceil(msat * EST_FEE_PPM / 1_000_000) + EST_FEE_BASE_MSAT


def amount_of(msat):
    """An amount as a person reads it: whole sats when it is whole sats, msat otherwise."""
    return f"{msat // 1000} sats" if msat % 1000 == 0 else f"{msat} msat"


@contextlib.contextmanager
def spent_lock():
    """Held across reading, checking and writing the spent log, so two runs in one container never
    both pass the total cap or overwrite each other's entries."""
    os.makedirs(ST, mode=0o700, exist_ok=True)
    fd = os.open(SPENT + ".lock", os.O_WRONLY | os.O_CREAT, 0o600)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX)
        yield
    finally:
        os.close(fd)


def spent_total(spent):
    return sum(e["reserved_msat"] if e["status"] == "reserved" else e["spent_msat"] for e in spent.values())


def deal_dir(conv):
    if not ID.match(conv):
        die("bad conversation id", 2)
    d = os.path.join(DEALS, conv)
    out = os.path.join(d, "outgoing")
    os.makedirs(out, mode=0o700, exist_ok=True)
    os.chmod(d, 0o700)
    return d, out


def now_ms():
    return int(time.time() * 1000)


def iso(ms):
    return datetime.datetime.fromtimestamp(ms / 1000, datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def cmd_invoice(conv):
    price = caps()["price_msat"]
    _, out = deal_dir(conv)
    path = os.path.join(out, "invoice.json")
    inv = load(path)
    if not (isinstance(inv, dict) and inv.get("expires_at_ms", 0) > now_ms() + 600_000):
        inv = wallet({"command": "fund", "amount_msat": price})
        # Every member `lightning receive` and `deal note --ln-invoice` read later, checked now,
        # while issuing another invoice costs nothing.
        if not (isinstance(inv, dict) and BOLT11.match(str(inv.get("bolt11", ""))) and HEX64.match(str(inv.get("payment_hash", "")))
                and inv.get("amount_msat") == price and NODE_ID.match(str(inv.get("payee", "")))
                and isinstance(inv.get("expires_at_ms"), int)):
            die("the wallet's invoice is not a mainnet invoice for your price; nothing was sent")
        write_private(path, inv)
    print(json.dumps({"invoice_ready": True, "amount_msat": inv["amount_msat"], "payment_hash": inv["payment_hash"],
                      "expires_at": iso(inv["expires_at_ms"]), "send_it_with": f"mbx reply {conv} proposal <text> '<constraints>' --invoice"}))


def over_total(spent, h, amount, total, c):
    """What the other payments in the log count against the total cap; refuses when this one would
    pass it."""
    already = spent_total({k: v for k, v in spent.items() if k != h})
    if already + amount > total:
        die(f"refused: paying {amount_of(amount)} would bring the sticker payments to "
            f"{amount_of(already + amount)}, over your total cap of {amount_of(total)}. Nothing paid")
    return already


def saved_invoice(conv):
    d, _ = deal_dir(conv)
    try:
        with open(os.path.join(d, "invoice.txt")) as f:
            bolt11 = f.read().strip()
    except FileNotFoundError:
        die("no invoice from the shop in this conversation: its proposal carried none (it may sell over the simulated payment)")
    if not BOLT11.match(bolt11):
        die("the saved invoice is not a mainnet BOLT11 invoice with an amount; nothing paid")
    return bolt11


def cmd_inspect(conv):
    inv = wallet({"command": "inspect_invoice", "invoice": saved_invoice(conv)})
    if not isinstance(inv, dict) or not isinstance(inv.get("amount_msat"), int):
        die("the shop's invoice names no fixed amount")
    print(json.dumps({"invoice_msat": inv["amount_msat"], "invoice": amount_of(inv["amount_msat"]),
                      "pays_node": inv.get("payee"), "expires_at": iso(inv.get("expires_at_ms", 0)),
                      "expired": inv.get("expires_at_ms", 0) <= now_ms() + 30_000}))


def cmd_pay(conv, msat, digest):
    if not re.match(r"^[1-9][0-9]{0,11}$", msat):
        die("amount is whole msat (the invoice_msat your user said yes to), no leading zero", 2)
    if not HEX64.match(digest):
        die("content digest is 64 lowercase hex", 2)
    c = caps()
    _, out = deal_dir(conv)
    if os.path.exists(os.path.join(out, "payment.json")):
        die(f"already paid in this conversation: {out}/payment.json")
    bolt11 = saved_invoice(conv)
    inv = wallet({"command": "inspect_invoice", "invoice": bolt11})
    amount = inv.get("amount_msat") if isinstance(inv, dict) else None
    h = str(inv.get("payment_hash", "")) if isinstance(inv, dict) else ""
    if not isinstance(amount, int) or amount < 1 or not HEX64.match(h):
        die("the shop's invoice names no fixed amount; nothing paid")
    if inv.get("expires_at_ms", 0) <= now_ms() + 30_000:
        die("the shop's invoice has expired (or expires within 30 s); a conversation keeps its first invoice, so this conversation cannot be paid now: tell your user, cancel this deal (mbx reply <conversation> cancel) and start a new purchase (mbx send). Nothing paid")
    if amount != int(msat):
        die(f"refused: the invoice asks {amount_of(amount)}, not the {amount_of(int(msat))} your user said yes to. Nothing paid")
    per, total = c["per_payment_msat"], c["total_msat"]
    if amount > per:
        die(f"refused: the invoice asks {amount_of(amount)}, over your per-payment cap of {amount_of(per)}. Nothing paid")
    est = est_fee(amount)
    if amount + est > per:
        die(f"refused: the invoice asks {amount_of(amount)} and Lexe's fee is expected to be about {amount_of(est)} more, "
            f"over your per-payment cap of {amount_of(per)}. Raise the cap with 'devcon8 lightning' if you accept that. Nothing paid")
    with spent_lock():
        early = load(SPENT, {})
    if early.get(h, {}).get("status") == "failed":
        die("this invoice's payment already failed; this conversation cannot be paid now: tell your user, cancel this deal (mbx reply <conversation> cancel) and start a new purchase (mbx send). Nothing paid")
    over_total(early, h, amount, total, c)
    terms = os.path.join(out, "buyer-terms.json")
    leg = load(terms)
    if leg is not None and str(((leg.get("settlement") or {}).get("amount") or {}).get("value")) != str(amount):
        os.remove(terms)  # an earlier attempt's leg for another amount: never attach it to this payment
    if not os.path.exists(terms):
        r = subprocess.run(["capsulectl", "--profile", "deal", "deal", "terms-leg", "--amount", str(amount), "--asset", BTC,
                            "--asset-scale", str(BTC_SCALE), "--content-digest", digest, "--out", terms],
                           stdout=subprocess.DEVNULL, stderr=subprocess.PIPE, text=True)
        if r.returncode:
            die("writing your terms leg failed, nothing paid: " + r.stderr.strip()[:300])
    # Reserve the most this payment can cost before sending, so a crash never lets the total cap
    # be passed; a rerun pays the same invoice at most once (the wallet keys a send by its hash).
    # The checks are made again under the lock, against the log as it is now.
    with spent_lock():
        spent = load(SPENT, {})
        if spent.get(h, {}).get("status") == "failed":
            die("this invoice's payment already failed; this conversation cannot be paid now: tell your user, cancel this deal (mbx reply <conversation> cancel) and start a new purchase (mbx send). Nothing paid")
        already = over_total(spent, h, amount, total, c)
        if already + amount + est > total:
            die(f"refused: paying {amount_of(amount)} and an expected fee of about {amount_of(est)} would bring the sticker payments to "
                f"{amount_of(already + amount + est)}, over your total cap of {amount_of(total)}. Nothing paid")
        spent[h] = {"conversation": conv, "status": "reserved", "reserved_msat": amount + est, "spent_msat": 0, "at": iso(now_ms())}
        write_private(SPENT, spent)
    try:
        tx = wallet({"command": "send", "invoice": bolt11}, timeout=300, refused_ok=True)
    except Refused as refused:
        # A refused send may still have a definite outcome in the wallet (a payment it tried and
        # failed, such as no route): read it, so a failure releases the reservation and a success
        # is not lost. With no record, the outcome is unknown and the reservation stays.
        tx = wallet({"command": "payment", "hash": h})
        if tx is not None and tx.get("inbound"):
            tx = None
        if tx is None or tx.get("status") not in ("succeeded", "failed"):
            die(f"the wallet refused 'send' ({refused}) and has no settled record of it; the outcome is unknown, so "
                "this payment stays counted against your caps. Look at 'devcon8 wallet'")
        if tx.get("status") == "failed" and tx.get("status_msg"):
            print(f"lightning: the wallet reports: {SAFE_TEXT.sub('', str(tx['status_msg']))[:200]}", file=sys.stderr)
    if not isinstance(tx, dict) or tx.get("payment_hash") != h:
        die("the wallet's answer names another payment; look at 'devcon8 wallet' before paying again")
    status = tx.get("status")
    paid = {"payment_hash": h, "amount_msat": tx.get("amount_msat"), "fee_msat": tx.get("fee_msat"), "status": status,
            "rail": "lightning", "network": "bitcoin mainnet"}
    if status in ("succeeded", "failed"):
        with spent_lock():
            spent = load(SPENT, {})
            entry = spent.get(h) or {"conversation": conv, "reserved_msat": 0, "at": iso(now_ms())}
            entry.update(status=status, spent_msat=int(tx.get("amount_msat", 0)) + int(tx.get("fee_msat", 0)) if status == "succeeded" else 0)
            spent[h] = entry
            write_private(SPENT, spent)
    if status == "succeeded" and int(tx.get("fee_msat", 0)) > est:
        print(f"lightning: Lexe charged a fee of {amount_of(int(tx['fee_msat']))}, more than the {amount_of(est)} expected; it is counted in your total", file=sys.stderr)
    if status != "succeeded":
        die(f"the payment did not succeed (status {status}); nothing to accept with. {'Nothing was paid.' if status == 'failed' else 'Look at devcon8 wallet.'}")
    write_private(os.path.join(out, "payment.json"), paid)
    print(f"REAL Lightning payment of {amount_of(amount)} (fee {paid['fee_msat']} msat), bitcoin mainnet.", file=sys.stderr)
    print(json.dumps({"paid": True, "amount_msat": amount, "fee_msat": paid["fee_msat"], "payment_hash": h, "paid_node": inv.get("payee"),
                      "terms_leg": terms, "payment": os.path.join(out, "payment.json")}))


def cmd_receive(conv, h, wait_s=120):
    if not HEX64.match(h):
        die("payment hash is 64 lowercase hex", 2)
    _, out = deal_dir(conv)
    inv = load(os.path.join(out, "invoice.json"))
    if not isinstance(inv, dict):
        die("you issued no invoice in this conversation ('lightning invoice' first)")
    if inv.get("payment_hash") != h:
        die("that payment hash is not the invoice you issued in this conversation: refusing to treat it as paid")
    end = time.time() + wait_s
    while True:
        tx = wallet({"command": "payment", "hash": h})
        if tx is not None and not tx.get("inbound"):
            tx = None
        if tx and tx.get("status") in ("succeeded", "failed"):
            break
        if time.time() >= end:
            die("your wallet has not reported that payment settled yet; run this again in a minute", 3)
        time.sleep(3)
    ln_invoice = os.path.join(out, "ln-invoice.json")
    ln_tx = os.path.join(out, "ln-transaction.json")
    write_private(ln_invoice, {k: inv[k] for k in ("payment_hash", "payee", "amount_msat", "expires_at_ms")})
    write_private(ln_tx, without_status_text(tx))
    print(json.dumps({"received": tx["status"] == "succeeded", "status": tx["status"], "credited_msat": tx.get("amount_msat"),
                      "fee_msat": tx.get("fee_msat"), "ln_invoice": ln_invoice, "ln_transaction": ln_tx}))


def cmd_caps():
    c = caps()
    spent = load(SPENT, {})
    print(json.dumps({**c, "paid_or_reserved_msat": spent_total(spent), "payments": len(spent)}))


def main(argv):
    cmd = argv[1] if len(argv) > 1 else "help"
    if cmd == "invoice" and len(argv) == 3:
        cmd_invoice(argv[2])
    elif cmd == "pay" and len(argv) == 5:
        cmd_pay(argv[2], argv[3], argv[4])
    elif cmd == "inspect" and len(argv) == 3:
        cmd_inspect(argv[2])
    elif cmd == "receive" and len(argv) == 4:
        cmd_receive(argv[2], argv[3])
    elif cmd == "caps" and len(argv) == 2:
        cmd_caps()
    else:
        print(__doc__.strip())
        sys.exit(0 if cmd in ("help", "-h", "--help") else 2)


if __name__ == "__main__":
    main(sys.argv)
